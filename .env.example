# ---------------------------------------------------------------------------
# ListenSpeak AI Coach - example environment
# Copy to .env (git-ignored) and fill in. NEVER commit a real .env.
# ---------------------------------------------------------------------------

# --- Backend runtime -------------------------------------------------------
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080

# Content source for AI features.
#   SEED = deterministic local fixtures, no provider calls, no cost
#   LIVE = real OpenAI calls (requires OPENAI_API_KEY)
APP_CONTENT_MODE=SEED

# --- OpenAI ----------------------------------------------------------------
# Local dev only. In AWS this value comes from Secrets Manager, never from here.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_GENERATION_MODEL=gpt-5.6-luna
OPENAI_SCORING_MODEL=gpt-5.6-terra
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe

# --- Storage ---------------------------------------------------------------
# LOCAL uses ./.local-data and LocalStack; AWS uses real DynamoDB + S3.
APP_STORAGE_MODE=LOCAL
APP_DYNAMODB_TABLE=listenspeak-dev
APP_AUDIO_BUCKET=
AWS_REGION=ca-central-1
# Only for LocalStack; leave empty against real AWS.
AWS_ENDPOINT_URL=http://localhost:4566

# --- Auth ------------------------------------------------------------------
# LOCAL_STUB accepts a dev identity header for local/e2e runs only.
# COGNITO validates real Cognito JWTs (used in AWS).
APP_AUTH_MODE=LOCAL_STUB
APP_COGNITO_ISSUER_URI=
APP_COGNITO_USER_POOL_ID=
APP_COGNITO_CLIENT_ID=

# --- Limits / cost controls ------------------------------------------------
APP_LIMITS_LISTENING_PER_DAY=20
APP_LIMITS_SPEAKING_PER_DAY=30
APP_LIMITS_BURST_PER_MINUTE=5
APP_SPEAKING_MAX_UPLOAD_BYTES=15728640

# --- CORS ------------------------------------------------------------------
# Comma-separated allowlist. 5173 = Vite dev server, 4173 = `vite preview` (e2e).
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# --- Frontend (Vite) -------------------------------------------------------
# Only VITE_* values reach the browser bundle. Never put a provider key here.
VITE_API_BASE_URL=http://localhost:8080
VITE_AUTH_MODE=LOCAL_STUB
VITE_COGNITO_DOMAIN=
VITE_COGNITO_CLIENT_ID=
VITE_COGNITO_REDIRECT_URI=http://localhost:5173/auth/callback
